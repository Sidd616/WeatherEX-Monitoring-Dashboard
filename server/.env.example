# All optional — sensible defaults are baked in, nothing here is required to run locally.

PORT=4000

# Base URL of the WeatherEX public API. Defaults to production.
API_BASE_URL=https://api.weatherex.ai

# Public GCS tile bucket base. Defaults to the production bucket used by platform-api-server.
TILE_PUBLIC_BASE=https://storage.googleapis.com/weather-tiles

# How often to run the full Tier-1 model x variable x day sweep, in minutes.
MATRIX_INTERVAL_MINUTES=30

# How often to run the Tier-2 platform-feature checks, in minutes.
FEATURES_INTERVAL_MINUTES=10

# Max concurrent outbound HTTP checks.
CHECK_CONCURRENCY=24

# Where the SQLite results database lives.
DB_PATH=./data/monitoring.db
